# Square API — server-only
# Get sandbox credentials: https://developer.squareup.com → your app → Sandbox tab
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Square Web Payments SDK — safe to expose to the browser
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# sandbox | production
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# Square Webhooks (server-only)
# Subscribe to `customer.deleted` in Square Developer Dashboard → your
# app → Webhooks. Set the endpoint to `<site>/api/webhooks/square`,
# then paste the Signature Key here and the same endpoint URL below
# (WebhooksHelper hashes the URL as part of signature verification).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# URL is safe to expose (identifies the project, not a secret).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (a.k.a. anon key in the legacy dashboard). Safe to
# expose — RLS-scoped, represents an unauthenticated browser request
# until a user session attaches. Used by the @supabase/ssr browser client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio credentials are no longer needed here — they're configured
# inside Supabase Dashboard → Auth → Providers → Phone (Supabase sends
# the OTP directly via your Twilio Verify service).

# Delivery (self-delivery by store staff)
# Public flag — must be "true" to expose the Delivery option in checkout.
# Default off so previews/PRs ship without the flow until prod is ready.
NEXT_PUBLIC_DELIVERY_ENABLED=false
# Google Places API key for delivery address autocomplete. Browser-exposed
# (NEXT_PUBLIC) — restrict by HTTP referrer + Places API in Google Cloud.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Cron auth — Vercel Cron sends Bearer <CRON_SECRET> on scheduled hits.
CRON_SECRET=

# ─── Order complaint channel (Resend transport) ────────────
# Resend API key (https://resend.com → API Keys). Server-only.
RESEND_API_KEY=
# Where complaint emails are sent.
COMPLAINT_TO_EMAIL=hello@mandybubbletea.com
# Sender. Domain must be verified in Resend (DNS SPF/DKIM/Return-Path).
COMPLAINT_FROM_EMAIL=noreply@mandybubbletea.com

# ─── Sentry error monitoring ───────────────────────────────
# DSN identifies the Sentry project — safe to expose to the browser.
# Get it from Sentry → Settings → Projects → <project> → Client Keys (DSN).
# Set BOTH (browser reads NEXT_PUBLIC_, server reads SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time source-map upload (CI / Vercel only — NOT needed for local dev).
# org/project slugs from your Sentry URL; auth token from Sentry → Settings →
# Auth Tokens (scope: project:releases). Keep the token in
# .env.sentry-build-plugin (gitignored) locally, or as a Vercel secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# POS tier discount — Square customer group ids (from scripts/setup-tier-pos-discount.ts)
# Webhook tier-group sync no-ops with a warn until these are set.
SQUARE_TIER_GROUP_GOLD_ID=
SQUARE_TIER_GROUP_DIAMOND_ID=

# ─── Chat rate limit ─────────────────────────────────────────
# Salt for hashing caller IPs before they're stored (src/lib/chat/rate-limit.ts).
# Must be set in Vercel — hashIp() throws if this is missing or empty, since
# an unsalted hash is publicly computable and enables targeted lockout.
CHAT_RATE_LIMIT_SALT=

# ─── Staff-only tools (/staff) ──────────────────────────────
# These pages live on the customer domain but are unlinked and noindexed, so
# the passcode is the actual gate — not obscurity. Two levels: STAFF opens the
# stock check, OWNER also opens the roster (which carries everyone's hours).
# Shared codes on purpose: staff shouldn't need accounts to count stock.
# If these are unset the gate fails closed and nobody gets in.
STAFF_PASSCODE=
OWNER_PASSCODE=
# Where the stock check report is emailed. Defaults to COMPLAINT_TO_EMAIL.
STOCK_REPORT_TO=
STOCK_REPORT_FROM=
