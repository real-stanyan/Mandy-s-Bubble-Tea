# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local scratch (snapshots, ad-hoc dumps)
/tmp/

# typescript
*.tsbuildinfo
next-env.d.ts
.env.test

# API contract tests — local only, never deploy
/tests/api-contract/
/vitest.contract.config.ts
/scripts/patch-testbaseline.ts
test-results-contract.json

# fortune seed scratch files
scripts/.tmp/
scripts/.flash-promo-sms-sent.log

# supabase CLI local state (created by `supabase link`; holds the linked
# project ref and a pooler URL, not migrations — those are in git)
supabase/.branches/
supabase/.temp/

.claude/worktrees/
